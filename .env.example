# Copy to .env and fill in. Restart the server after any change.

# ---- Meta (Muse Spark) -------------------------------------------------
LLM_PROVIDER=meta
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
META_MODEL_FAST=muse-spark-1.3
META_MODEL_VISION=muse-spark-1.3

# Muse models always "think". Lower effort = much faster + cheaper.
# minimal | low | medium | high | xhigh   (if Meta rejects it, the app retries without it)
LLM_REASONING_EFFORT_FAST=minimal
LLM_REASONING_EFFORT_VISION=low
LLM_MAX_OUTPUT_TOKENS=4096     # thinking tokens count against this

# ---- Speed / limits ------------------------------------------------------
LLM_TIMEOUT_S=90               # per LLM request (was 25s - too short for reasoning models)
LLM_MAX_RPM=30                 # check your Meta rate limit and raise it if you can
MAX_COST_USD_PER_RUN=2.00
MAX_ACTIONS_PER_STEP=6
MAX_TOTAL_ACTIONS=40
MAX_RUN_MINUTES=20
STEP_TIMEOUT_S=240

# ---- Gemini (optional, only if LLM_PROVIDER=gemini) ----------------------
# GEMINI_API_KEY=
# GEMINI_MODEL_FAST=gemini-flash-lite-latest
# GEMINI_MODEL_VISION=gemini-flash-lite-latest

# ---- Optional: GitHub issue export ---------------------------------------
GITHUB_TOKEN=
GITHUB_REPO=
